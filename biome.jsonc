{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "files": {
    "includes": [
      "!_bmad",
      "!.agent/skills",
      "!.agents/skills",
      "!.claude/skills",
      "!.worktrees",
      "!**/src/migrations"
    ]
  },
  "javascript": {
    "globals": [
      "afterAll",
      "afterEach",
      "beforeAll",
      "beforeEach",
      "describe",
      "expect",
      "it",
      "jest",
      "test"
    ]
  }
}
